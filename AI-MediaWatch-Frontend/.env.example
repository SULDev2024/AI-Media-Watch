# Copy to .env in this directory. Replace both credential placeholders.
# Supported Windows demo: browser 5174 -> API 8003 -> Local Agent 8002.
AIMW_ENV=dev
AIMW_LOG_LEVEL=INFO
AIMW_EAGER=1
AIMW_FAST_ANALYSIS=0
AIMW_AUTO_PURGE_CLEAN=false
AIMW_DATA_DIR=./data
AIMW_API_HOST=127.0.0.1
AIMW_API_PORT=8003
AIMW_ADMIN_EMAIL=admin@example.invalid
AIMW_ADMIN_PASSWORD=REPLACE_WITH_A_PRIVATE_PASSWORD
AIMW_JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
AIMW_GPU_PIPELINE_URL=http://127.0.0.1:8002
AIMW_GPU_PIPELINE_TIMEOUT_S=900
AIMW_LLM_PROVIDER=local
AIMW_LLM_BASE_URL=http://127.0.0.1:11434/v1
AIMW_LLM_MODEL=qwen2.5vl:latest
AIMW_LLM_REQUIRE_AUTH=false

# Optional integrations; not needed for uploaded media.
# AIMW_GROQ_API_KEY=REPLACE_WITH_YOUR_KEY
# AIMW_TELEGRAM_API_ID=REPLACE_WITH_YOUR_NUMERIC_ID
# AIMW_TELEGRAM_API_HASH=REPLACE_WITH_YOUR_HASH
# AIMW_TELEGRAM_SESSION=REPLACE_WITH_YOUR_PRIVATE_SESSION
# AIMW_TELEGRAM_BOT_TOKEN=REPLACE_WITH_YOUR_BOT_TOKEN
# AIMW_REDIS_URL=redis://127.0.0.1:6379/0
