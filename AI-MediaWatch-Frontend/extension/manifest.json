{
  "manifest_version": 3,
  "name": "AI MediaWatch - Scam Detector",
  "version": "1.0.0",
  "description": "Detects financial scam content on Instagram, YouTube, and TikTok in real-time using AI MediaWatch",
  "permissions": ["storage", "notifications"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://www.youtube.com/*",
        "https://youtu.be/*",
        "https://www.tiktok.com/*",
        "https://web.telegram.org/*",
        "https://t.me/*"
      ],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
